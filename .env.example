# Salin file ini menjadi ".env" lalu isi sesuai server kamu.

# --- Database (MariaDB/MySQL async, contoh pakai aiomysql) ---
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/rumahdrive

# --- Wajib diisi: kunci rahasia untuk menandatangani token login (JWT) ---
# Isi bebas, panjang & acak. Contoh generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-yang-panjang

# --- Folder root penyimpanan file ---
DIR=/mnt/storage

PORT=8000
DEBUG=false

# --- Kunci root filesystem (dipakai endpoint upload/hapus tingkat root) ---
# Nilai mentah ini dibandingkan (dalam bentuk base64) dengan variabel KEY.
KEY=

# --- (Opsional) Akun keluarga pertama, dibuat otomatis saat server pertama kali nyala ---
# Kalau dikosongkan, daftar manual lewat POST /thorix-api/auth/register (hanya bisa
# dipanggil tanpa login selama tabel akun masih kosong).
ADMIN_NAMA=Keluarga
ADMIN_EMAIL=
ADMIN_PASSWORD=
